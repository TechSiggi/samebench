#!/usr/bin/env python3
"""Connect a kernel console to a notebook's kernel.

Usage (Neovim does this with <Space>jk):
    <jupyter-venv>/bin/python -I jupyter-attach <file>

* If <file> is an .ipynb and a local JupyterLab server whose folder contains
  the notebook is running, the notebook's session is used, or created. When
  the notebook is opened in the browser afterwards, the browser uses the SAME
  kernel, so variables from Neovim are available there for plots.
* Otherwise a plain `jupyter console` starts with its own kernel.

Python standard library only. Talks exclusively to servers on
127.0.0.1 / localhost and never through a proxy, so the token stays on
the machine.
"""

import json
import os
import subprocess
import sys
import urllib.parse
import urllib.request
from pathlib import Path

JUPYTER = str(Path(sys.executable).parent / "jupyter")
LOCAL_HOSTS = {"127.0.0.1", "localhost", "::1"}
# urllib would send requests to a proxy from the environment (http_proxy), token included
DIRECT = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def servers():
    try:
        out = subprocess.run(
            [JUPYTER, "server", "list", "--json"], capture_output=True, text=True, check=True
        ).stdout
    except (OSError, subprocess.CalledProcessError):
        return []
    found = []
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("{"):
            try:
                found.append(json.loads(line))
            except json.JSONDecodeError:
                pass
    return found


def is_local(url):
    return urllib.parse.urlparse(url).hostname in LOCAL_HOSTS


def api(server, method, path, body=None):
    url = server["url"].rstrip("/") + "/api/" + path
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", "token " + server.get("token", ""))
    if data is not None:
        req.add_header("Content-Type", "application/json")
    with DIRECT.open(req, timeout=10) as resp:
        payload = resp.read().decode()
    return json.loads(payload) if payload else None


def attach_to_notebook(nb):
    for server in servers():
        if not is_local(server.get("url", "")):
            continue
        root = Path(server.get("root_dir") or server.get("notebook_dir") or "/").resolve()
        try:
            rel = nb.relative_to(root).as_posix()
        except ValueError:
            continue
        sessions = api(server, "GET", "sessions") or []
        session = next((s for s in sessions if s.get("path") == rel), None)
        if session is None:
            session = api(
                server,
                "POST",
                "sessions",
                {"path": rel, "name": nb.name, "type": "notebook", "kernel": {"name": "python3"}},
            )
            print(f"Started a new kernel for {rel}, the browser will use the same one.")
        else:
            print(f"Connected to the running kernel of {rel}.")
        kernel_id = session["kernel"]["id"]
        os.execv(JUPYTER, [JUPYTER, "console", "--existing", f"kernel-{kernel_id}.json"])
    print("No local JupyterLab server found for this folder (window 'jupyter' in tmux).")
    print("Starting a separate kernel, its variables will NOT be visible in the browser.\n")


def main():
    target = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else None
    if target is not None and target.suffix == ".ipynb":
        try:
            attach_to_notebook(target)
        except Exception as exc:  # noqa: BLE001, the console should start anyway
            print(f"Connecting to the JupyterLab server failed: {exc}\n")
    # Separate kernel: in `dev -j` sessions "python3" is the kernel of the project's .venv
    # (JUPYTER_PATH), connected over local sockets instead of TCP.
    os.execv(JUPYTER, [JUPYTER, "console", "--kernel=python3", "--transport=ipc"])


if __name__ == "__main__":
    main()
